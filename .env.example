# Postgres
POSTGRES_USER=callback_scheduler
POSTGRES_PASSWORD=callback_scheduler
POSTGRES_DB=callback_scheduler
POSTGRES_PORT=5432

# Built from the POSTGRES_* values above; used by the API to connect
DATABASE_URL=postgres://callback_scheduler:callback_scheduler@db:5432/callback_scheduler

# API
API_PORT=3000

# Web
WEB_PORT=5173
# Base URL the React app calls from the browser (not the docker-internal one)
VITE_API_BASE_URL=http://localhost:3000

# Calling window (lead-local time, 24h). Read into one config object so the
# live "move the window" change only touches this + the config loader.
CALLING_WINDOW_START=08:00
CALLING_WINDOW_END=21:00
